#!/bin/sh
#
# create volumes directory tree
#

BIN_DIR="$(cd "$(dirname $0)" ; pwd )"
. $BIN_DIR/common.sh
. $VIRES_CONTAINER_ROOT/common.sh


cd "$VIRES_CONTAINER_ROOT"

# create directory tree
while read DIR
do
    mkdir -p "$DIR"
    [ -f "$DIR/.gitignore" ] || echo "*" > "$DIR/.gitignore"
done <<END
volumes
volumes/cache/optimized
volumes/home
volumes/logs
volumes/logs/httpd
volumes/logs/oauth
volumes/logs/aeolus
volumes/logs/jhub
volumes/secrets
volumes/oauth
volumes/aeolus
volumes/jhub
END

# initial user accounts
echo '[]' > volumes/secrets/users.json
